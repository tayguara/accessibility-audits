# Public demo values of the OpenMRS reference distribution (documented upstream).
# They are public demo credentials, not secrets. Copy to .env (gitignored).

# The port must match GATEWAY_PORT in ../scan/.env.
OPENMRS_BASE_URL=http://127.0.0.1:8091/openmrs
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
# Outpatient Clinic
OPENMRS_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1

